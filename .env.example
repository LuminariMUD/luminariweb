# .env.example - Environment variables for the application, template file - YES commit

# Cloudflare account ID used by local scripts/tools that call the Cloudflare API.
CLOUDFLARE_ACCOUNT_ID=<cloudflare_account_id>

# Cloudflare API token for authenticated API requests.
# Keep this value private and rotate it if it is ever shared or committed.
CLOUDFLARE_API_TOKEN=<cloudflare_api_token>

# in case you need to log onto the production MUD server to make tweaks
#   to get things running (it also has sudo access)
REMOTE_LOGIN_COMMAND="<ssh command>"
REMOTE_LOGIN_SUDO_PASSWORD=<sudo_password>
# path of the project on the remote server
REMOTE_PROJECT_PATH=/home/luminari/Luminari-Source
